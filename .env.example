# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atulglass_erp?schema=public"

# Session Signing Secret Key (64+ character random hex string in production)
SESSION_SECRET="replace-with-secure-random-secret-key-for-session-signing-atga-2026"

# Environment & Port Binding
NODE_ENV="production"
PORT=3000
# Host loopback port for multi-tenant VPS (avoids port 3000 collisions)
APP_HOST_PORT=3040
